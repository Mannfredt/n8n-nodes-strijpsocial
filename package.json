{
  "name": "n8n-nodes-strijpsocial",
  "version": "0.1.1",
  "description": "n8n community node to schedule and publish posts across multiple social platforms with StrijpSocial",
  "license": "MIT",
  "homepage": "https://strijpsocial.com",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "strijpsocial",
    "social-media",
    "scheduler"
  ],
  "author": {
    "name": "HitowerIT",
    "email": "r.vanhaare@hitowerit.com.my"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mannfredt/n8n-nodes-strijpsocial.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/StrijpsocialApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Strijpsocial/StrijpSocial.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
